# =============================================
# Save Sabi Environment Configuration
# =============================================
# Copy this file to .env and update values

# Django Core
# -----------
DEBUG=False
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.run.app

# Database
# --------
# For local development (SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL
# DATABASE_URL=postgres://user:password@localhost:5432/save_sabi

# For Cloud SQL (via Unix socket)
# DATABASE_URL=postgres://user:password@/save_sabi?host=/cloudsql/project:region:instance

# Redis & Celery
# --------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
# --------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Google Cloud (for production)
# -----------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_SECRET_NAME=save-sabi-secrets

# GCS Bucket for static/media files
# Leave empty for local development (uses WhiteNoise)
GCS_BUCKET_NAME=your-bucket-name

# Application Settings
# --------------------
# Default savings ratio (percentage)
DEFAULT_SAVINGS_RATIO=20

# Enable round-up feature
ENABLE_ROUND_UP=True

# Nudge settings
NUDGE_COOLDOWN_HOURS=24
MAX_NUDGES_PER_DAY=5

# Logging
# -------
LOG_LEVEL=INFO

# Sentry (optional)
# -----------------
# SENTRY_DSN=https://xxx@sentry.io/xxx
